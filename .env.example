# Core
LOG_LEVEL=info
PORT=3000
DB_PATH=data/bridge.db
# LOCALE=fr-FR           # Optional - default: fr-FR
# TIMEZONE=Europe/Paris  # Optional - default: Europe/Paris
# COUNTRY=FR             # Optional - default: FR
# RUN_ON_STARTUP=true
# ADMIN_SECRET=          # Optional - enables admin endpoints (POST /test/:source) via x-admin-secret header

# Plugins (comma-separated list of plugins to disable, all enabled by default)
# DISABLED_PLUGINS=epic,itad,twitch-prime

# Plugin deals
DISCORD_DEALS_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_DEALS_EPIC_THREAD_ID=     # Optional - post Epic deals to a specific thread
# DISCORD_DEALS_ITAD_THREAD_ID=     # Optional - post ITAD deals to a specific thread
# DISCORD_DEALS_PRIME_THREAD_ID=    # Optional - post Prime deals to a specific thread
ITAD_API_KEY=xxxx

# Plugin twitch-prime
# Setup: add TWITCH_PRIME_REDIRECT_URI to your Twitch app's Redirect URIs, then visit GET /twitch-prime/auth
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_PRIME_REDIRECT_URI=http://localhost:3000/twitch-prime/callback
DISCORD_TWITCH_PRIME_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_TWITCH_PRIME_THREAD_ID=   # Optional - post to a specific thread
# TWITCH_PRIME_CHANNEL=             # Optional - can be set via GET /twitch-prime

# Notifier gotify
# GOTIFY_URL=https://gotify.example.<com
# GOTIFY_EPIC_TOKEN=                 # Optional - Gotify app token for Epic deals
# GOTIFY_ITAD_TOKEN=                 # Optional - Gotify app token for ITAD deals
# GOTIFY_PRIME_TOKEN=                # Optional - Gotify app token for Amazon Prime deals
# GOTIFY_DEALS_PRIORITY=5            # Optional - default: 5 (0-10), shared for the 3 above
# GOTIFY_TWITCH_PRIME_TOKEN=
# GOTIFY_TWITCH_PRIME_PRIORITY=5     # Optional - default: 5 (0-10)

# Notifier mail (SMTP)
# Shared SMTP connection, then recipients. Activation rules:
#   - MAIL_TO set            -> mail active for ALL sources (default recipient)
#   - MAIL_<SOURCE>_TO set   -> overrides the recipient for that source (or activates it alone)
# Effective recipient of a source = MAIL_<SOURCE>_TO if set, else MAIL_TO.
# Any recipient being set makes the SMTP block required (partial config crashes the boot).
